<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GalleryRecorder.Yorutina</AssemblyName>
    <RootNamespace>GalleryRecorder.Adapters.Yorutina</RootNamespace>
    <Version>0.1.0</Version>
    <GameDir>$(YorutinaDir)</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GalleryRecorder.Core\GalleryRecorder.Core.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\Elringus.Naninovel.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\Naninovel.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\UniTask.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\Unity.ResourceManager.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\UnityEngine.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(GameDir)\*_Data\Managed\UnityEngine.UIElementsModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployAdapter" AfterTargets="Build" Condition="'$(Deploy)' == 'true' And Exists('$(GameDir)\BepInEx')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\GalleryRecorder" />
  </Target>
</Project>
